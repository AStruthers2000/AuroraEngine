########################################################################################################################
# Aurora Engine — .gitignore
# C++ project using CMake, Conan2, VSCode
########################################################################################################################

# ── Build output ────────────────────────────────────────────────────────────────
build/
Build/
out/

# ── Compiled artifacts ──────────────────────────────────────────────────────────
*.o
*.obj
*.slo
*.lo
*.gch
*.pch
*.ilk
*.pdb
*.so
*.so.*
*.dylib
*.dll
*.lai
*.la
*.a
*.lib
*.exe
*.dwo

# ── CMake generated files ───────────────────────────────────────────────────────
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile
install_manifest.txt
# compile_commands.json is generated per-build, not committed; IntelliSense reads it from build/
compile_commands.json
# CMakeUserPresets.json is auto-generated by Conan — do not commit
CMakeUserPresets.json

# ── Conan ───────────────────────────────────────────────────────────────────────
# Conan local cache lives in ~/.conan2; nothing from it belongs in this repo
.conan/
.conan2/

# ── VSCode user-local files ─────────────────────────────────────────────────────
# Commit: .vscode/tasks.json, launch.json, c_cpp_properties.json, settings.json,
#         extensions.json  — these are shared workspace configuration files.
# Ignore: per-user state / IntelliSense caches
.vscode/*.db
.vscode/ipch/
.vscode/browse.VC.db
.vscode/browse.VC.db-shm
.vscode/browse.VC.db-wal

# ── JetBrains IDEs (CLion, etc.) ────────────────────────────────────────────────
.idea/
cmake-build-*/

# ── Temporary / editor swap files ───────────────────────────────────────────────
*.tmp
*.log
*.bak
*.swp

# ── Debug / test output ──────────────────────────────────────────────────────────
Testing/
.cache/

# ── Project-specific notes (kept local, not for version control) ─────────────────
/public/core/subsystems/input/input_axis_notes.md

