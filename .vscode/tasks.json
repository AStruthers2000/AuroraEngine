{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Conan: Install (Debug)",
            "type": "shell",
            "command": "conan install . --output-folder=build/debug --build=missing -s build_type=Debug",
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "Conan: Install (Release)",
            "type": "shell",
            "command": "conan install . --output-folder=build/release --build=missing -s build_type=Release",
