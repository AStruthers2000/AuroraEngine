{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Conan: Install (Debug)",
            "type": "shell",
            "command": "conan install . --output-folder=build/debug --build=missing -s build_type=Debug",
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "Conan: Install (Release)",
            "type": "shell",
            "command": "conan install . --output-folder=build/release --build=missing -s build_type=Release",
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "CMake: Configure (Debug)",
            "type": "shell",
            "command": "cmake -S . -B build/debug -G Ninja -DCMAKE_TOOLCHAIN_FILE=build/debug/generators/conan_toolchain.cmake -DCMAKE_BUILD_TYPE=Debug -DCMAKE_EXPORT_COMPILE_COMMANDS=ON",
            "group": "build",
            "dependsOn": "Conan: Install (Debug)",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "CMake: Configure (Release)",
            "type": "shell",
            "command": "cmake -S . -B build/release -G Ninja -DCMAKE_TOOLCHAIN_FILE=build/release/generators/conan_toolchain.cmake -DCMAKE_BUILD_TYPE=Release -DCMAKE_EXPORT_COMPILE_COMMANDS=ON",
            "group": "build",
            "dependsOn": "Conan: Install (Release)",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Build: Engine (Debug)",
            "type": "shell",
            "command": "cmake --build build/debug --target AuroraEngine",
            "group": "build",
            "dependsOn": "CMake: Configure (Debug)",
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Build: Engine (Release)",
            "type": "shell",
            "command": "cmake --build build/release --target AuroraEngine",
            "group": "build",
            "dependsOn": "CMake: Configure (Release)",
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Build: Test Game (Debug)",
            "type": "shell",
            "command": "cmake --build build/debug --target AuroraEngineTest",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "dependsOn": "CMake: Configure (Debug)",
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Build: Test Game (Release)",
            "type": "shell",
            "command": "cmake --build build/release --target AuroraEngineTest",
            "group": "build",
            "dependsOn": "CMake: Configure (Release)",
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Conan: Package Engine",
            "type": "shell",
            "command": "conan create . --build=missing",
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": []
        }
    ]
}
